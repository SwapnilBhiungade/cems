# ==========================================================
# CEMS Environment Variables Template (.env.example)
# Copy this file to .env and substitute real credentials
# NEVER commit the active .env file to Git!
# ==========================================================

# ----------------- Application Security -----------------
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-secure-random-64-character-hex-string
DEBUG=false
ENABLE_METRICS=true

# ----------------- Session Security -----------------
# Set to true when serving behind HTTPS (ALB / Ingress / CloudFront)
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Lax

# ----------------- Database Configuration -----------------
# Mode A (Local Docker Compose):
# DB_HOST=mysql
# DB_PORT=3306
# DB_USER=cems_user
# DB_PASSWORD=cems_secure_password
# DB_NAME=campus_events

# Mode B (AWS RDS Production):
DB_HOST=cems-mysql-db.xxxxxxxxx.ap-south-1.rds.amazonaws.com
DB_PORT=3306
DB_USER=cems_admin
DB_PASSWORD=replace-with-strong-db-password
DB_NAME=campus_events

# SSL / TLS Settings for Managed Database (Optional for AWS RDS)
DB_CA=./certs/isrgrootx1.pem
DB_SSL_VERIFY_CERT=false
DB_SSL_VERIFY_IDENTITY=false

# ----------------- Cloudinary Media Storage -----------------
# Required for shared image uploads across multiple pods/containers
# Option 1: Full URL format
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
# Option 2: Individual variables
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_FOLDER=cems-share/gallery

# ----------------- Gunicorn Tuning -----------------
GUNICORN_WORKERS=3
GUNICORN_THREADS=2
GUNICORN_TIMEOUT=60
